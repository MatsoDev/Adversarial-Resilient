# Keep the build context small: the image copies runtime requirements,
# src/, api/, dashboard/, scripts/ and committed docs/ artifacts (see Dockerfile).

.git
.gitignore
.gitattributes
.github

.venv
.venv-*
venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
build/
dist/

# Runtime data / outputs (never needed to build)
data/
models/
mlruns/
mlartifacts/
# The read-only dashboard consumes compact research artifacts.
docs/results/baselines/
notebooks/
tests/
*.html
!dashboard/web/*.html
*.md
!docs/**/*.md

# Secrets
.env
.env.*
*.key
*.pem
*.p12
id_rsa*
id_ed25519*
Plan ( Dont Push)/
ember_dataset_*.tar.bz2
