# Keep the build context small: the image only needs requirements.txt,
# src/, api/, dashboard/ and scripts/ (see Dockerfile).

.git
.gitignore
.gitattributes
.github

.venv
.venv-*
venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime data / outputs (never needed to build)
data/
models/
mlruns/
mlartifacts/
docs/
notebooks/
tests/
*.html
*.md

# Secrets
.env
.env.*
*.key
*.pem
*.p12
id_rsa*
id_ed25519*
