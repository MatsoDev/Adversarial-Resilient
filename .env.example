# Copy to .env before `docker compose up` (never commit .env).
# The defaults bind published ports to localhost only. Set BIND_ADDR=0.0.0.0
# only when you intentionally expose the stack, and put authentication/TLS in
# front of it first.
BIND_ADDR=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
MLFLOW_PORT=5000

# Optional API hardening (safe defaults are built in):
# API_ALLOWED_HOSTS=localhost,127.0.0.1,api
# API_DOCS_ENABLED=true
